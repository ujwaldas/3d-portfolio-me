  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "face:preview": "esbuild src/three/sampleFace.ts --format=esm --outfile=scripts/.sampleFace.mjs --log-level=warning && node scripts/preview.mjs",
